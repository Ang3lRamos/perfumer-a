# URL pública del sitio (canonical, Open Graph). En Vercel se toma sola del dominio de producción.
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# Supabase → Project Settings → API. La publishable key es pública por diseño (RLS protege los datos).
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Número de WhatsApp del negocio en formato internacional sin "+" (ej. 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMERO=
